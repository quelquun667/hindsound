<Window x:Class="OverlayProbe.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hindsound notification"
        Width="360" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Grid x:Name="Root" Width="360" Height="64" ClipToBounds="False">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" X="0" />
    </Grid.RenderTransform>
    <Grid.Clip>
      <PathGeometry Figures="M14,0 L360,0 L360,64 L0,64 L0,14 Z" />
    </Grid.Clip>

    <Path Data="M14,0 L360,0 L360,64 L0,64 L0,14 Z" Fill="#3A404C" />
    <Path Data="M14.41,1 L360,1 L360,63 L1,63 L1,14.41 Z" Fill="#15181E" />

    <Rectangle Width="4" Height="64" HorizontalAlignment="Right" Fill="#D4F53C">
      <Rectangle.Effect>
        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="#D4F53C" Opacity="0.7" />
      </Rectangle.Effect>
    </Rectangle>

    <Canvas x:Name="Bars" Width="96" Height="40" Margin="14,12,0,0"
            HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform>
        <ScaleTransform x:Name="BarsScale" ScaleY="1" />
      </Canvas.RenderTransform>
      <Canvas.Effect>
        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="#D4F53C" Opacity="0.6" />
      </Canvas.Effect>
    </Canvas>

    <StackPanel Margin="122,10,14,0" VerticalAlignment="Top">
      <TextBlock Text="Clip saved (0:30)" Height="22" Foreground="#F2F4F7" FontSize="19"
                 FontFamily="Bahnschrift SemiBold SemiCondensed, Segoe UI Semibold" TextOptions.TextFormattingMode="Display" />
      <StackPanel Orientation="Horizontal" Height="20" Margin="0,2,0,0">
        <TextBlock Text="Copied. Paste" Foreground="#AAB1BE" FontSize="13" FontFamily="Segoe UI"
                   VerticalAlignment="Center" Margin="0,0,6,0" TextOptions.TextFormattingMode="Display" />
        <Border Height="20" Padding="6,0" Margin="0,0,4,0" CornerRadius="3" Background="#21252D" BorderBrush="#6B7382" BorderThickness="1">
          <TextBlock Text="Ctrl" Foreground="#F2F4F7" FontSize="12" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
        </Border>
        <Border Height="20" Padding="6,0" CornerRadius="3" Background="#21252D" BorderBrush="#6B7382" BorderThickness="1">
          <TextBlock Text="V" Foreground="#F2F4F7" FontSize="12" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
