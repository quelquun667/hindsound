<Window x:Class="OverlayProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hindsound overlay probe" Width="760" Height="460"
        Background="#0D0F13" Foreground="#F2F4F7" FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Ctrl+Shift+F10: what Hindsound would do. In exclusive fullscreen, a sound and no notification." Margin="0,0,0,4" />
      <TextBlock Text="Ctrl+Shift+F11: always show the notification. Use it to test exclusive fullscreen." Margin="0,0,0,4" />
      <TextBlock Text="Each press also copies a test MP3: paste it in Discord with Ctrl+V." Margin="0,0,0,4" />
      <TextBlock x:Name="LogPath" Foreground="#AAB1BE" />
    </StackPanel>
    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Background="#15181E" Foreground="#F2F4F7"
             BorderBrush="#3A404C" Padding="8" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
  </DockPanel>
</Window>
