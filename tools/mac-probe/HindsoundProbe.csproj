<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway probe of the macOS port, built and run only by .github/workflows/mac-probe.yml. Not part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HindsoundProbe</AssemblyName>
    <RootNamespace>HindsoundProbe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <!-- The build number makes version 2 a different binary from version 1, for the permission test across versions. -->
    <ProbeBuild Condition="'$(ProbeBuild)' == ''">1</ProbeBuild>
    <InformationalVersion>0.0.$(ProbeBuild)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ProbeBuild" Value="$(ProbeBuild)" />
  </ItemGroup>

</Project>
