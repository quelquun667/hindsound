# The overrides of the package hindsound, each with its reason. build-deb.sh installs this file as
# /usr/share/lintian/overrides/hindsound.

# The app has no manual page: its options are for scripts and tests, and the README says what a person needs.
hindsound: no-manual-page
hindsound: binary-without-manpage

# /usr/lib/hindsound/hindsound is a self-contained, single-file .NET program: the bundle is appended to the ELF file,
# and strip would cut it off. The encoder and the window library are the files of the other packages, unchanged.
hindsound: unstripped-binary-or-object

# The encoder and the window library are private copies, next to the program, where the app looks for them first:
# Ubuntu 22.04 and 24.04 have no SDL3 package, and the encoder is built with the options the app was checked with.
hindsound: embedded-library
