<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The sheet of the tray icon writes through the canvas's pointer, as the app does. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The capture tests count the bytes a callback allocates. With background GC, that count jumped in 5 full runs out of 31, for threads that allocated nothing; without it, in none of 30. The published app runs without it too. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests run on pool threads, and each pool thread that calls user32 holds a USER object of the process until it ends. An
         idle pool thread ends by itself after 20 s: in 2 full runs out of 10, one or two ended during the 200 drawings of the text
         leak test, and its count of USER objects fell by as many. Kept alive, the pool threads leave that count to the code under test. -->
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.ThreadsToKeepAlive" Value="-1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Mp3FileReader, to read back the MP3 files in the tests. The app itself only needs NAudio.Wasapi. -->
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Helpers shared with Hindsound.Core.Tests, which holds them: they declare no test, so nothing runs twice. -->
    <Compile Include="..\Hindsound.Core.Tests\CoreScan.cs" Link="Shared\CoreScan.cs" />
    <Compile Include="..\Hindsound.Core.Tests\Export\TestSupport.cs" Link="Shared\TestSupport.cs" />
    <Compile Include="..\Hindsound.Core.Tests\Updates\FakeTransport.cs" Link="Shared\FakeTransport.cs" />
    <Compile Include="..\Hindsound.Core.Tests\Updates\TempFolder.cs" Link="Shared\TempFolder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hindsound.Core\Hindsound.Core.csproj" />
    <ProjectReference Include="..\..\src\Hindsound\Hindsound.csproj" />
  </ItemGroup>

</Project>